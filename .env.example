# Local app configuration. Copy this file to .env and adjust if needed.
HOST=127.0.0.1
PORT=5000
MAX_UPLOAD_MB=12
MAX_IMAGE_PIXELS=40000000
DATABASE_PATH=instance/neurovista.sqlite3
UPLOAD_FOLDER=instance/uploads
MODEL_PATH=models/brain_tumor_resnet50.pt
# Change before exposing any instance beyond localhost. The app currently has no user accounts.
SECRET_KEY=replace-this-with-a-long-random-value
